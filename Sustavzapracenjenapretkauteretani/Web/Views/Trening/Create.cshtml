@model Sustavzapracenjenapretkauteretani.Web.Models.TreningCreateViewModel

@{
    ViewData["Title"] = "Novi trening";
}

<style>
    .create-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .create-header {
        margin-bottom: 28px;
    }

    .create-header h1 {
        font-size: 32px;
        font-weight: 800;
        color: var(--color-text-primary);
        margin-bottom: 8px;
    }

    .create-header p {
        color: var(--color-text-secondary);
        margin: 0;
    }

    .create-form {
        display: grid;
        gap: 20px;
    }

    .form-section {
        background: var(--color-surface-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 12px;
        padding: 24px;
    }

    .form-section h2 {
        font-size: 18px;
        margin: 0 0 16px 0;
        color: var(--color-text-primary);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-field-full {
        grid-column: 1 / -1;
    }

    .form-field label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-secondary);
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
        background: var(--color-base-800);
        border: 1px solid var(--color-border-default);
        color: var(--color-text-primary);
        border-radius: 8px;
        padding: 10px 12px;
        min-height: 44px;
        font-size: 14px;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
        outline: 2px solid rgba(16, 185, 129, 0.55);
        outline-offset: 1px;
        border-color: var(--color-primary-600);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    }

    .field-hint {
        font-size: 12px;
        color: var(--color-text-tertiary);
    }

    .validation-text {
        color: #fca5a5;
        font-size: 12px;
    }

    .validation-summary {
        background: rgba(220, 38, 38, 0.14);
        border: 1px solid rgba(220, 38, 38, 0.45);
        border-radius: 10px;
        padding: 12px 14px;
        color: #fecaca;
        margin-bottom: 16px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .btn-main,
    .btn-muted {
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid transparent;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-main {
        background: var(--color-primary-600);
        color: #042018;
    }

    .btn-main:hover {
        background: var(--color-primary-500);
    }

    .btn-muted {
        background: transparent;
        border-color: var(--color-border-default);
        color: var(--color-text-secondary);
    }

    .btn-muted:hover {
        border-color: var(--color-primary-600);
        color: var(--color-text-primary);
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-main,
        .btn-muted {
            width: 100%;
        }
    }
</style>

<div class="create-wrapper">
    <div class="create-header">
        <h1>Novi trening</h1>
        <p>Zabilježite novi trening — datum, vrstu, trajanje i detaljne informacije.</p>
    </div>

    <form asp-route="TreningCreate" method="post" class="create-form">
        @Html.AntiForgeryToken()

        <partial name="_TreningFormPartial" model="Model" />

        <div class="form-actions">
            <a asp-route="TreninziIndex" class="btn-muted">
                <i class="fas fa-times"></i> Odustani
            </a>
            <button type="submit" class="btn-main">
                <i class="fas fa-save"></i> Spremi trening
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
