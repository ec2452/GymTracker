@model Trening

@{
    ViewData["Title"] = "Obriši trening";
}

<style>
    .delete-wrapper { max-width: 560px; margin: 60px auto; }
    .delete-card {
        background: var(--color-surface-800);
        border: 1px solid rgba(220, 38, 38, 0.4);
        border-radius: 16px;
        padding: 40px;
        text-align: center;
    }
    .delete-icon { font-size: 48px; color: #ef4444; margin-bottom: 20px; }
    .delete-card h1 { font-size: 24px; font-weight: 800; color: var(--color-text-primary); margin-bottom: 12px; }
    .delete-card p { color: var(--color-text-secondary); margin-bottom: 8px; }
    .delete-warning { color: #fca5a5; font-size: 13px; margin-bottom: 24px !important; }
    .delete-info {
        background: var(--color-base-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 28px;
        text-align: left;
    }
    .delete-info-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
    .delete-info-label { color: var(--color-text-tertiary); }
    .delete-info-value { color: var(--color-text-primary); font-weight: 600; }
    .delete-actions { display: flex; gap: 12px; justify-content: center; }
    .btn-muted, .btn-danger {
        min-height: 44px; padding: 10px 20px; border-radius: 8px;
        font-weight: 700; text-decoration: none; display: inline-flex;
        align-items: center; gap: 8px; cursor: pointer; border: 1px solid transparent;
    }
    .btn-muted { background: transparent; border-color: var(--color-border-default); color: var(--color-text-secondary); }
    .btn-muted:hover { border-color: var(--color-primary-600); color: var(--color-text-primary); }
    .btn-danger { background: #dc2626; color: white; }
    .btn-danger:hover { background: #b91c1c; }
</style>

<div class="delete-wrapper">
    <div class="delete-card">
        <div class="delete-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <h1>Obriši trening</h1>
        <p>Jeste li sigurni da želite obrisati ovaj trening?</p>
        <p class="delete-warning">Ova radnja je nepovratna i ne može se poništiti.</p>

        <div class="delete-info">
            <div class="delete-info-row">
                <span class="delete-info-label">Korisnik</span>
                <span class="delete-info-value">@Model.Korisnik?.Ime @Model.Korisnik?.Prezime</span>
            </div>
            <div class="delete-info-row">
                <span class="delete-info-label">Datum</span>
                <span class="delete-info-value">@Model.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
            <div class="delete-info-row">
                <span class="delete-info-label">Vrsta</span>
                <span class="delete-info-value">@Model.Vrsta</span>
            </div>
            <div class="delete-info-row">
                <span class="delete-info-label">Trajanje</span>
                <span class="delete-info-value">@Model.TrajanjeMinuta min</span>
            </div>
        </div>

        <div class="delete-actions">
            <a asp-route="TreningDetails" asp-route-id="@Model.Id" class="btn-muted">
                <i class="fas fa-times"></i> Odustani
            </a>
            <form asp-route="TreningDeletePost" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-danger">
                    <i class="fas fa-trash"></i> Potvrdi brisanje
                </button>
            </form>
        </div>
    </div>
</div>
