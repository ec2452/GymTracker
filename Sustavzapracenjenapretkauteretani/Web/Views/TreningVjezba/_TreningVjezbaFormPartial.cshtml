@model Sustavzapracenjenapretkauteretani.Web.Models.TreningVjezbaCreateViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="form-section">
    <h2>Izbor treninga i vježbe</h2>
    <div class="form-grid">

        <partial name="_AutocompleteField" model='new AutocompleteFieldViewModel {
            FieldName = "TreningId",
            Label = "Trening",
            Endpoint = "/treninzi/pretraga",
            InitialValue = Model.TreningDisplayText,
            InitialId = Model.TreningId > 0 ? Model.TreningId : null
        }' />

        <partial name="_AutocompleteField" model='new AutocompleteFieldViewModel {
            FieldName = "VjezbaId",
            Label = "Vježba",
            Endpoint = "/vjezbe/pretraga",
            InitialValue = Model.VjezbaDisplayText,
            InitialId = Model.VjezbaId > 0 ? Model.VjezbaId : null
        }' />

    </div>
</section>

<section class="form-section">
    <h2>Detalji izvedbe</h2>
    <div class="form-grid">

        <div class="form-field">
            <label asp-for="BrojSerija"></label>
            <input asp-for="BrojSerija" type="number" min="1" max="20" />
            <span asp-validation-for="BrojSerija" class="validation-text"></span>
            <span class="field-hint">Koliko setova / serija? (1-20)</span>
        </div>

        <div class="form-field">
            <label asp-for="BrojPonavljanja"></label>
            <input asp-for="BrojPonavljanja" type="number" min="1" max="100" />
            <span asp-validation-for="BrojPonavljanja" class="validation-text"></span>
            <span class="field-hint">Ponavljanja po seriji (1-100)</span>
        </div>

        <div class="form-field">
            <label asp-for="TezinaKg"></label>
            <input asp-for="TezinaKg" type="number" min="0" max="500" step="0.5" />
            <span asp-validation-for="TezinaKg" class="validation-text"></span>
            <span class="field-hint">Težina (0-500 kg) — opcionalno za kardio</span>
        </div>

        <div class="form-field">
            <label asp-for="OdmorSekundi"></label>
            <input asp-for="OdmorSekundi" type="number" min="0" max="600" />
            <span asp-validation-for="OdmorSekundi" class="validation-text"></span>
            <span class="field-hint">Odmor između serija u sekundama (0-600)</span>
        </div>

        <div class="form-field">
            <label asp-for="Redoslijed"></label>
            <input asp-for="Redoslijed" type="number" min="1" max="100" />
            <span asp-validation-for="Redoslijed" class="validation-text"></span>
            <span class="field-hint">Redni broj u treningu (1-100)</span>
        </div>

    </div>
</section>
