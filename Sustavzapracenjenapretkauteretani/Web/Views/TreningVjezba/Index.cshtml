@model List<TreningVjezba>

@{
    ViewData["Title"] = "TreningVjezbe";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h1 class="mb-1">Trening vježbe</h1>
        <p class="text-muted">Poveznica treninga i vježbi s detaljima izvedbe.</p>
    </div>
    <a asp-route="TreningVjezbaCreate" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 18px; border-radius: 8px; background: var(--color-primary-600); color: #042018; font-weight: 700; text-decoration: none;">
        <i class="fas fa-plus"></i> Nova vježba
    </a>
</div>

<!-- SEARCH -->
<div style="position: relative; margin-bottom: 24px; max-width: 400px;">
    <input type="text" id="tv-search-input" placeholder="Pretraži vježbe..." 
           style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-border-default); border-radius: 8px; background: var(--color-surface-900); color: var(--color-text-primary); font-size: 14px;" />
    <div id="tv-search-results" style="position: absolute; top: 100%; left: 0; right: 0; background: var(--color-surface-800); border: 1px solid var(--color-border-default); border-radius: 8px; z-index: 100; max-height: 200px; overflow-y: auto; margin-top: 4px; display: none;"></div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Trening</th>
                <th>Vjezba</th>
                <th>Redni broj</th>
                <th>Broj serija</th>
                <th>Ponavljanja</th>
                <th>Tezina</th>
                <th>Odmor</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tv in Model)
            {
                <tr>
                    <td>@tv.TreningId</td>
                    <td>@(tv.Vjezba?.Naziv ?? "-")</td>
                    <td>@tv.Redoslijed</td>
                    <td>@tv.BrojSerija</td>
                    <td>@tv.BrojPonavljanja</td>
                    <td>@(tv.TezinaKg?.ToString("0.#") ?? "-")</td>
                    <td>@tv.OdmorSekundi sec</td>
                    <td style="display: flex; gap: 8px;">
                        <a asp-route="TreningVjezbaDetails" asp-route-id="@tv.Id" asp-route-slug="@SlugHelper.Slugify($"{tv.Vjezba?.Naziv ?? "trening-vjezba"} {tv.TreningId} {tv.Redoslijed}")" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; background: #10b981; color: white; text-decoration: none; font-size: 12px;">
                            <i class="fas fa-eye"></i> Detalji
                        </a>
                        <a asp-route="TreningVjezbaEdit" asp-route-id="@tv.Id" asp-route-slug="@SlugHelper.Slugify($"{tv.Vjezba?.Naziv ?? "trening-vjezba"} {tv.TreningId} {tv.Redoslijed}")" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; background: #3b82f6; color: white; text-decoration: none; font-size: 12px;">
                            <i class="fas fa-edit"></i> Uredi
                        </a>
                        <a asp-route="TreningVjezbaDelete" asp-route-id="@tv.Id" asp-route-slug="@SlugHelper.Slugify($"{tv.Vjezba?.Naziv ?? "trening-vjezba"} {tv.TreningId} {tv.Redoslijed}")" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; background: #ef4444; color: white; text-decoration: none; font-size: 12px;">
                            <i class="fas fa-trash"></i> Obriši
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        initIndexSearch('tv-search-input', 'tv-search-results', '/trening-vjezbe/pretraga');
    });
</script>
