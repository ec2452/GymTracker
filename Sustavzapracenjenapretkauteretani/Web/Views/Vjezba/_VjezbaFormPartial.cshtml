@model Sustavzapracenjenapretkauteretani.Web.Models.VjezbaCreateViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="form-section">
    <h2>Osnovni podaci</h2>
    <div class="form-grid">

        <div class="form-field form-field-full">
            <label asp-for="Naziv"></label>
            <input asp-for="Naziv" placeholder="npr. Bench Press, Čučnjevi..." />
            <span asp-validation-for="Naziv" class="validation-text"></span>
        </div>

        <div class="form-field form-field-full">
            <label asp-for="Opis"></label>
            <textarea asp-for="Opis" rows="4" style="background: var(--color-base-800); border: 1px solid var(--color-border-default); color: var(--color-text-primary); border-radius: 8px; padding: 10px 12px; font-size: 14px; resize: vertical;" placeholder="Opišite kako se vježba ispravno izvodi..."></textarea>
            <span asp-validation-for="Opis" class="validation-text"></span>
        </div>

    </div>
</section>

<section class="form-section">
    <h2>Klasifikacija</h2>
    <div class="form-grid">

        <div class="form-field">
            <label asp-for="MisicnaSkupina"></label>
            <select asp-for="MisicnaSkupina" asp-items="Html.GetEnumSelectList<MisicnaSkupina>()"></select>
            <span asp-validation-for="MisicnaSkupina" class="validation-text"></span>
        </div>

        <div class="form-field">
            <label asp-for="RazinaTezine"></label>
            <select asp-for="RazinaTezine">
                <option value="1">1 — Početnik</option>
                <option value="2">2 — Početni</option>
                <option value="3">3 — Srednji</option>
                <option value="4">4 — Napredan</option>
                <option value="5">5 — Profesionalno</option>
            </select>
            <span asp-validation-for="RazinaTezine" class="validation-text"></span>
        </div>

        <div class="form-field">
            <label asp-for="VideoUrl"></label>
            <input asp-for="VideoUrl" type="url" placeholder="https://youtube.com/..." />
            <span asp-validation-for="VideoUrl" class="validation-text"></span>
            <span class="field-hint">Opcionalno — URL YouTube videa s demonstracijom</span>
        </div>

        <div class="form-field" style="justify-content: center;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--color-text-secondary);">
                <input asp-for="PotrebnaOprema" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--color-primary-600); cursor: pointer;" />
                @Html.DisplayNameFor(m => m.PotrebnaOprema)
            </label>
            <span class="field-hint">Označite ako vježba zahtijeva tegove, sprave ili drugu opremu</span>
        </div>

    </div>
</section>
