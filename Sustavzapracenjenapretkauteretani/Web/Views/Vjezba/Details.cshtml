@model Vjezba

@{
    ViewData["Title"] = $"Detalji vježbe - {Model.Naziv}";
    var difficultyClass = $"level-{Model.RazinaTezine}";
    var difficultyText = Model.RazinaTezine switch
    {
        1 => "Početnik",
        2 => "Početni",
        3 => "Srednji",
        4 => "Napredan",
        5 => "Profesionalno",
        _ => "Nepoznato"
    };
    var muscleGroupDisplay = Model.MisicnaSkupina.ToString();
    var muscleGroupColor = Model.MisicnaSkupina switch
    {
        MisicnaSkupina.Prsa => "#ef4444",
        MisicnaSkupina.Leda => "#f97316",
        MisicnaSkupina.Ramena => "#eab308",
        MisicnaSkupina.Biceps => "#3b82f6",
        MisicnaSkupina.Triceps => "#06b6d4",
        MisicnaSkupina.Noge => "#8b5cf6",
        MisicnaSkupina.Trbuh => "#14b8a6",
        MisicnaSkupina.Kardio => "#ec4899",
        MisicnaSkupina.CijeloTijelo => "#6366f1",
        _ => "#64748b"
    };
}

<style>
    .exercise-hero {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(59, 130, 246, 0.05) 100%);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 16px;
        padding: 48px 32px;
        margin-bottom: 40px;
        position: relative;
        overflow: hidden;
    }

    .exercise-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .exercise-hero-content {
        position: relative;
        z-index: 1;
    }

    .difficulty-stars {
        display: inline-flex;
        gap: 6px;
        margin-top: 12px;
    }

    .difficulty-stars i {
        font-size: 18px;
        opacity: 0.3;
        transition: color 0.2s, opacity 0.2s;
    }

    .difficulty-stars i.filled {
        opacity: 1;
    }

    .video-container {
        background: var(--color-surface-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 32px;
        text-align: center;
    }

    .related-section {
        margin-bottom: 40px;
    }

    .related-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .related-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .related-item {
        background: var(--color-surface-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 8px;
        padding: 16px;
        transition: all 0.2s;
    }

    .related-item:hover {
        border-color: var(--color-primary-500);
        background: var(--color-surface-700);
    }

    .related-item-title {
        font-weight: 600;
        color: var(--color-text-primary);
        margin-bottom: 8px;
    }

    .related-item-meta {
        font-size: 13px;
        color: var(--color-text-tertiary);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .empty-state-related {
        text-align: center;
        padding: 32px 24px;
        background: var(--color-surface-800);
        border: 1px dashed var(--color-border-subtle);
        border-radius: 8px;
        color: var(--color-text-tertiary);
    }

    /* Header Button Styles */
    .detail-header-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #2A2D3A;
        margin-bottom: 24px;
    }

    .detail-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 8px;
        background: transparent;
        color: #94A3B8;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .detail-back-link:hover {
        background: #1C1F2A;
        color: #F1F5F9;
    }

    .detail-buttons-group {
        display: flex;
        gap: 8px;
    }

    .detail-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        border-radius: 8px;
        background: transparent;
        color: #3B82F6;
        border: 1px solid #3B82F6;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .detail-edit-link:hover {
        background: #3B82F620;
    }

    .detail-delete-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        border-radius: 8px;
        background: transparent;
        color: #EF4444;
        border: 1px solid #EF4444;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .detail-delete-link:hover {
        background: #EF444415;
    }

    /* Hero Section */
    .exercise-hero {
        background: linear-gradient(135deg, #1C1F2A 0%, #16192a 100%);
        border: 1px solid #2A2D3A;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    }

    .exercise-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .exercise-hero-content {
        position: relative;
        z-index: 1;
    }

    .exercise-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #F1F5F9;
        margin-bottom: 20px;
        margin-top: 0;
    }

    .exercise-info-row {
        display: flex;
        gap: 32px;
        align-items: center;
        margin-bottom: 20px;
    }

    .exercise-info-item {
        display: flex;
        flex-direction: column;
    }

    .exercise-info-separator {
        border-left: 1px solid #2A2D3A;
        padding-left: 32px;
    }

    .exercise-info-label {
        font-size: 11px;
        letter-spacing: 0.1em;
        color: #64748B;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .exercise-info-value {
        font-size: 16px;
        font-weight: 600;
        color: #F1F5F9;
    }

    .exercise-difficulty-stars {
        display: flex;
        gap: 4px;
        align-items: center;
    }

    .exercise-difficulty-stars i {
        font-size: 20px;
        color: #F59E0B;
    }

    .exercise-difficulty-stars i:not(.filled) {
        color: #374151;
    }

    .exercise-muscle-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 16px;
        font-weight: 600;
        color: #F1F5F9;
    }

    .exercise-muscle-dot {
        width: 12px;
        height: 12px;
        border-radius: 4px;
    }

    .exercise-description {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #2A2D3A;
        color: #94A3B8;
        font-size: 15px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Specs Grid */
    .specs-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    @@media (max-width: 768px) {
        .specs-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .specs-grid {
            grid-template-columns: 1fr;
        }
    }

    .spec-card {
        background: #1C1F2A;
        border: 1px solid #2A2D3A;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .spec-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748B;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .spec-label i {
        font-size: 14px;
    }

    .spec-value {
        font-size: 18px;
        font-weight: 700;
        color: #F1F5F9;
    }

    /* Description Section */
    .exercise-full-description {
        background: #1C1F2A;
        border: 1px solid #2A2D3A;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 32px;
    }

    .exercise-full-description h2 {
        margin: 0 0 12px 0;
        font-size: 14px;
        text-transform: uppercase;
        color: #64748B;
        letter-spacing: 0.08em;
    }

    .exercise-full-description p {
        margin: 0;
        color: #94A3B8;
        line-height: 1.7;
    }

    /* Video Container */
    .video-container {
        background: #1C1F2A;
        border: 1px solid #2A2D3A;
        border-radius: 12px;
        padding: 48px 24px;
        margin-bottom: 32px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 200px;
    }

    .video-container i {
        color: #374151;
        font-size: 48px;
        margin-bottom: 16px;
    }

    .video-container p {
        color: #64748B;
        font-size: 14px;
        margin: 0;
    }

    /* Main Content Wrapper */
    .exercise-details-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 24px;
        background: #0F1117;
    }

    /* =============================================
       ANIMACIJE — PAGE ENTER STAGGERED REVEAL
       ============================================= */
    .animiraj-ulaz {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.5s ease, transform 0.5s ease;
        will-change: transform, opacity;
    }

    .animiraj-ulaz.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* =============================================
       ANIMACIJE — ZVJEZDICE COUNT-UP
       ============================================= */
    .zvjezdica {
        font-size: 20px;
        color: #374151;
        display: inline-block;
        transform: scale(1);
        transition: color 0.2s ease, transform 0.2s ease;
        cursor: default;
        user-select: none;
    }

    @@keyframes zvjezdica-bounce {
        0%   { transform: scale(0.3); color: #374151; }
        60%  { transform: scale(1.4); color: #F59E0B; }
        100% { transform: scale(1.0); color: #F59E0B; }
    }

    .zvjezdica.animirana {
        animation: zvjezdica-bounce 0.35s ease forwards;
    }

    /* =============================================
       ANIMACIJE — DETALJ KARTICE HOVER LIFT
       ============================================= */
    .spec-card {
        transition: transform 0.25s ease,
                    box-shadow 0.25s ease,
                    border-color 0.25s ease;
        cursor: default;
        will-change: transform;
    }

    .spec-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        border-color: #3A3D4A;
    }

    .spec-card:hover .detalj-ikona {
        transform: scale(1.2);
    }

    .detalj-ikona {
        transition: transform 0.25s ease;
        display: inline-block;
    }
</style>

<div class="exercise-details-wrapper">

    <!-- HEADER WITH BUTTONS -->
    <div class="detail-header-wrapper animiraj-ulaz">
        <a asp-route="VjezbeIndex" class="detail-back-link">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Natrag
        </a>
        <div class="detail-buttons-group">
            <a asp-route="VjezbaEdit"
               asp-route-id="@Model.Id"
               asp-route-slug="@SlugHelper.Slugify(Model.Naziv)"
               class="detail-edit-link">
                <i class="fas fa-edit"></i> Uredi
            </a>
            <a asp-route="VjezbaDelete"
               asp-route-id="@Model.Id"
               asp-route-slug="@SlugHelper.Slugify(Model.Naziv)"
               class="detail-delete-link">
                <i class="fas fa-trash"></i> Obriši
            </a>
        </div>
    </div>

    <!-- HERO SECTION -->
    <div class="exercise-hero animiraj-ulaz">
        <div class="exercise-hero-content">
            <h1 class="exercise-title">@Model.Naziv</h1>

            <!-- DIFFICULTY AND MUSCLE GROUP INFO -->
            <div class="exercise-info-row">
                <div class="exercise-info-item">
                    <span class="exercise-info-label">Razina Težine</span>
                    <div class="exercise-difficulty-stars" data-razina="@Model.RazinaTezine">
                        @for (int i = 0; i < 5; i++)
                        {
                            <span class="zvjezdica"
                                  data-index="@i"
                                  data-aktivna="@(i < Model.RazinaTezine ? "true" : "false")">★</span>
                        }
                    </div>
                </div>
                <div class="exercise-info-item exercise-info-separator">
                    <span class="exercise-info-label">Mišićna Skupina</span>
                    <div class="exercise-muscle-badge">
                        <div class="exercise-muscle-dot" style="background: @muscleGroupColor;"></div>
                        <span>@muscleGroupDisplay</span>
                    </div>
                </div>
            </div>

            <!-- SHORT DESCRIPTION -->
            @if (!string.IsNullOrWhiteSpace(Model.Opis))
            {
                <p class="exercise-description">
                    @(Model.Opis.Length > 150 ? Model.Opis.Substring(0, 150) + "..." : Model.Opis)
                </p>
            }
        </div>
    </div>

    <!-- FULL DESCRIPTION -->
    @if (!string.IsNullOrWhiteSpace(Model.Opis))
    {
        <div class="exercise-full-description animiraj-ulaz">
            <h2>Detaljni Opis Vježbe</h2>
            <p>@Model.Opis</p>
        </div>
    }

    <!-- SPECS GRID -->
    <div class="specs-grid animiraj-ulaz">
        <div class="spec-card">
            <div class="spec-label">
                <i class="fas fa-layer-group detalj-ikona"></i> Težina
            </div>
            <div class="spec-value">
                <span class="tezina-broj" data-cilj="@Model.RazinaTezine">0</span>
            </div>
            <p style="margin: 8px 0 0; font-size: 12px; color: var(--color-text-tertiary);">od 5</p>
        </div>

        <div class="spec-card">
            <div class="spec-label">
                <i class="fas fa-toolbox detalj-ikona"></i> Oprema
            </div>
            <div class="spec-value" style="color: @(Model.PotrebnaOprema ? "#10b981" : "#64748b");">
                @(Model.PotrebnaOprema ? "DA" : "NE")
            </div>
            <p style="margin: 8px 0 0; font-size: 12px; color: var(--color-text-tertiary);">
                @(Model.PotrebnaOprema ? "Potrebna je oprema" : "Bez opreme")
            </p>
        </div>

        <div class="spec-card">
            <div class="spec-label">
                <i class="fas fa-dumbbell detalj-ikona"></i> Tip
            </div>
            <div class="spec-value" style="font-size: 18px;">@muscleGroupDisplay</div>
            <p style="margin: 8px 0 0; font-size: 12px; color: var(--color-text-tertiary);">Mišićna skupina</p>
        </div>
    </div>

    <!-- VIDEO SECTION -->
    @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
    {
        <div class="video-container animiraj-ulaz">
            <i class="fas fa-film"></i>
            <h3 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 600; color: var(--color-text-primary);">Video Demonstracija</h3>
            <p style="margin: 0 0 16px 0; color: var(--color-text-secondary); font-size: 14px;">
                Pogledajte kako se ispravno izvodi ova vježba
            </p>
            <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.2s; border: none; cursor: pointer;">
                <i class="fas fa-play" style="font-size: 14px;"></i>
                Otvori Video na YouTubeu
                <i class="fas fa-external-link-alt" style="font-size: 11px;"></i>
            </a>
        </div>
    }
    else
    {
        <div class="video-container animiraj-ulaz">
            <i class="fas fa-video"></i>
            <p>Nema dostupnog videa za ovu vježbu</p>
        </div>
    }

    <!-- RELATED TRAININGS -->
    @if (Model.TreningVjezbe != null && Model.TreningVjezbe.Count > 0)
    {
        <div class="related-section animiraj-ulaz">
            <div class="related-title">
                <i class="fas fa-users"></i>
                Koristi se u Trenicima
            </div>
            <div class="related-list">
                @foreach (var treningVjezba in Model.TreningVjezbe.Take(6))
                {
                    <div class="related-item">
                        <div class="related-item-title">@treningVjezba.Vjezba?.Naziv</div>
                        <div class="related-item-meta">
                            <span>
                                <i class="fas fa-tag"></i>
                                @(treningVjezba.BrojSerija) serija
                            </span>
                            <span>
                                <i class="fas fa-heartbeat"></i>
                                @(treningVjezba.BrojPonavljanja) ponavljanja
                            </span>
                        </div>
                    </div>
                }
            </div>
            @if (Model.TreningVjezbe.Count > 6)
            {
                <p style="text-align: center; color: var(--color-text-tertiary); margin-top: 16px; font-size: 13px;">
                    + još @(Model.TreningVjezbe.Count - 6) treninga
                </p>
            }
        </div>
    }
    else
    {
        <div class="related-section animiraj-ulaz">
            <div class="related-title">
                <i class="fas fa-users"></i>
                Koristi se u Trenicima
            </div>
            <div class="empty-state-related">
                <i class="fas fa-inbox" style="font-size: 32px; margin-bottom: 12px; display: block; opacity: 0.5;"></i>
                <p style="margin: 0;">Ova vježba se još ne koristi ni u jednom treningu</p>
            </div>
        </div>
    }

    <!-- RELATED PLANS -->
    @if (Model.Planovi != null && Model.Planovi.Count > 0)
    {
        <div class="related-section animiraj-ulaz">
            <div class="related-title">
                <i class="fas fa-calendar"></i>
                Koristi se u Planovima
            </div>
            <div class="related-list">
                @foreach (var plan in Model.Planovi.Take(6))
                {
                    <div class="related-item">
                        <div class="related-item-title">@plan.Naziv</div>
                        <div class="related-item-meta">
                            <span>
                                <i class="fas fa-layer-group"></i>
                                @(plan.TrajanjeTjedana) tjedana
                            </span>
                        </div>
                    </div>
                }
            </div>
            @if (Model.Planovi.Count > 6)
            {
                <p style="text-align: center; color: var(--color-text-tertiary); margin-top: 16px; font-size: 13px;">
                    + još @(Model.Planovi.Count - 6) planova
                </p>
            }
        </div>
    }
    else
    {
        <div class="related-section animiraj-ulaz">
            <div class="related-title">
                <i class="fas fa-calendar"></i>
                Koristi se u Planovima
            </div>
            <div class="empty-state-related">
                <i class="fas fa-clipboard-list" style="font-size: 32px; margin-bottom: 12px; display: block; opacity: 0.5;"></i>
                <p style="margin: 0;">Ova vježba se još ne koristi ni u jednom planu</p>
            </div>
        </div>
    }

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // =======================================================
    // 1. PAGE ENTER — STAGGERED REVEAL
    // =======================================================
    const elementi = document.querySelectorAll('.animiraj-ulaz');
    elementi.forEach(function (el, index) {
        setTimeout(function () {
            el.classList.add('visible');
        }, index * 120);
    });

    // =======================================================
    // 2. ZVJEZDICE — COUNT-UP ANIMACIJA (IntersectionObserver)
    // =======================================================
    var heroKartica = document.querySelector('.exercise-hero');

    if (heroKartica) {
        var zvjezdiceObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    var razina = parseInt(
                        document.querySelector('[data-razina]').dataset.razina
                    );
                    var zvjezdice = document.querySelectorAll('.zvjezdica');

                    zvjezdice.forEach(function (zvjezdica, index) {
                        if (zvjezdica.dataset.aktivna === 'true') {
                            setTimeout(function () {
                                zvjezdica.classList.add('animirana');
                            }, index * 150);
                        }
                    });

                    zvjezdiceObserver.unobserve(entry.target); // samo jednom
                }
            });
        }, { threshold: 0.5 });

        zvjezdiceObserver.observe(heroKartica);
    }

    // =======================================================
    // 4. ANIMIRANI COUNTER ZA TEŽINU
    // =======================================================
    function animirajCounter(element) {
        var cilj = parseInt(element.dataset.cilj);
        var trajanje = 800;
        var pocetak = performance.now();

        function korak(trenutnoVrijeme) {
            var proteklo = trenutnoVrijeme - pocetak;
            var napredak = Math.min(proteklo / trajanje, 1);
            // Ease-out cubic — brzo na početku, sporo pri kraju
            var eased = 1 - Math.pow(1 - napredak, 3);
            element.textContent = Math.round(eased * cilj);

            if (napredak < 1) {
                requestAnimationFrame(korak);
            }
        }

        requestAnimationFrame(korak);
    }

    var tezinaBroj = document.querySelector('.tezina-broj');
    if (tezinaBroj) {
        animirajCounter(tezinaBroj);
    }

});
</script>
