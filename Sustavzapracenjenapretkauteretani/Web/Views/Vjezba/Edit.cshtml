@model Sustavzapracenjenapretkauteretani.Web.Models.VjezbaCreateViewModel

@{
    ViewData["Title"] = $"Uredi vježbu — {Model.Naziv}";
}

<style>
    .create-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .create-header {
        margin-bottom: 28px;
    }

    .create-header h1 {
        font-size: 32px;
        font-weight: 800;
        color: var(--color-text-primary);
        margin-bottom: 8px;
    }

    .create-header p {
        color: var(--color-text-secondary);
        margin: 0;
    }

    .create-form {
        display: grid;
        gap: 20px;
    }

    .form-section {
        background: var(--color-surface-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 12px;
        padding: 24px;
    }

    .form-section h2 {
        font-size: 18px;
        margin: 0 0 16px 0;
        color: var(--color-text-primary);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-field-full {
        grid-column: 1 / -1;
    }

    .form-field label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-secondary);
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
        background: var(--color-base-800);
        border: 1px solid var(--color-border-default);
        color: var(--color-text-primary);
        border-radius: 8px;
        padding: 10px 12px;
        min-height: 44px;
        font-size: 14px;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
        outline: 2px solid rgba(16, 185, 129, 0.55);
        outline-offset: 1px;
        border-color: var(--color-primary-600);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    }

    .field-hint {
        font-size: 12px;
        color: var(--color-text-tertiary);
    }

    .validation-text {
        color: #fca5a5;
        font-size: 12px;
    }

    .validation-summary {
        background: rgba(220, 38, 38, 0.14);
        border: 1px solid rgba(220, 38, 38, 0.45);
        border-radius: 10px;
        padding: 12px 14px;
        color: #fecaca;
        margin-bottom: 16px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .btn-main,
    .btn-muted {
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid transparent;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-main {
        background: var(--color-primary-600);
        color: #042018;
    }

    .btn-main:hover {
        background: var(--color-primary-500);
    }

    .btn-muted {
        background: transparent;
        border-color: var(--color-border-default);
        color: var(--color-text-secondary);
    }

    .btn-muted:hover {
        border-color: var(--color-primary-600);
        color: var(--color-text-primary);
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-column: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-main,
        .btn-muted {
            width: 100%;
        }
    }
</style>

<style>
    .edit-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        max-width: 1200px;
        margin: 0 auto;
    }

    @@media (max-width: 900px) {
        .edit-layout { grid-template-columns: 1fr; }
    }

    .dropzone-section h2 {
        font-size: 18px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin-bottom: 12px;
    }

    #attachmentDz {
        background: var(--color-surface-800);
        border: 2px dashed var(--color-border-default);
        border-radius: 12px;
        padding: 24px;
        min-height: 140px;
        color: var(--color-text-secondary);
        cursor: pointer;
        transition: border-color 0.2s;
    }

    #attachmentDz.dz-drag-hover {
        border-color: var(--color-primary-600);
        background: rgba(16, 185, 129, 0.06);
    }

    #attachmentDz .dz-message {
        text-align: center;
        font-size: 14px;
    }

    .attachment-list {
        list-style: none;
        padding: 0;
        margin: 16px 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .attachment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--color-surface-800);
        border: 1px solid var(--color-border-subtle);
        border-radius: 8px;
        padding: 10px 14px;
    }

    .attachment-link {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--color-text-primary);
        text-decoration: none;
        font-size: 14px;
    }

    .attachment-link:hover { color: var(--color-primary-600); }
    .attachment-link small { color: var(--color-text-tertiary); }

    .attachment-delete {
        background: transparent;
        border: none;
        color: var(--color-text-tertiary);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: color 0.15s, background 0.15s;
    }

    .attachment-delete:hover {
        color: #f87171;
        background: rgba(248, 113, 113, 0.1);
    }

    .attachment-empty {
        color: var(--color-text-tertiary);
        font-size: 14px;
        margin-top: 12px;
    }
</style>

<div class="edit-layout">
    <div>
        <div class="create-header">
            <h1>Uredi vježbu</h1>
            <p>Ažurirajte podatke o vježbi <strong>@Model.Naziv</strong>.</p>
        </div>

        <form asp-route="VjezbaEditPost"
              asp-route-id="@Model.Id"
              asp-route-slug="@SlugHelper.Slugify(Model.Naziv)"
              method="post" class="create-form">
            @Html.AntiForgeryToken()

            <partial name="_VjezbaFormPartial" model="Model" />

            <div class="form-actions">
                <a asp-route="VjezbeIndex" class="btn-muted">
                    <i class="fas fa-times"></i> Odustani
                </a>
                <button type="submit" class="btn-main">
                    <i class="fas fa-save"></i> Spremi promjene
                </button>
            </div>
        </form>
    </div>
<!-- dropzone -->
    <div class="dropzone-section">
        <h2><i class="fas fa-paperclip"></i> Priložene datoteke</h2>
        <p style="font-size:13px;color:var(--color-text-secondary);margin-bottom:12px;">
            Dozvoljeni formati: JPG, PNG, GIF, WebP, PDF — max 10 MB
        </p>

        <form id="attachmentDz"
              asp-route="VjezbaUpload"
              asp-route-id="@Model.Id"
              enctype="multipart/form-data"
              class="dropzone">
        </form>

        <div id="attachmentList">
            @await Html.PartialAsync("_AttachmentList",
                ViewBag.Attachments as List<Teretana.Models.Attachment> ?? new List<Teretana.Models.Attachment>())
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.js"></script>
    <script type="text/javascript">
        Dropzone.autoDiscover = false;

        var dz = new Dropzone("#attachmentDz", {
            paramName: "file",
            maxFilesize: 10,
            acceptedFiles: "image/*,.pdf",
            dictDefaultMessage: "<i class='fas fa-cloud-upload-alt fa-2x' style='margin-bottom:8px;display:block;'></i>Povucite datoteke ovdje ili kliknite za odabir",
            success: function (file, response) {
                this.removeFile(file);
                loadAttachments();
            },
            error: function (file, message) {
                alert("Greška: " + (typeof message === "string" ? message : message.title ?? "Greška pri uploadu"));
                this.removeFile(file);
            }
        });

        $(function () {
            loadAttachments();
        });

        function loadAttachments() {
            $("#attachmentList").load("@Url.RouteUrl("VjezbaAttachments", new { id = Model.Id })");
        }

        function deleteAttachment(id) {
            if (!confirm("Obrisati ovu datoteku?")) return;
            $.ajax({
                url: "@Url.RouteUrl("AttachmentDelete")",
                method: "POST",
                data: { id: id },
                success: function () {
                    loadAttachments();
                }
            });
        }
    </script>
}
