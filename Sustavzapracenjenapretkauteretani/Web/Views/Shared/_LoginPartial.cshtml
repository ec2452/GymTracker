@using Microsoft.AspNetCore.Identity
@using Teretana.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var initials = user?.Email?.Length > 0 ? user.Email[0].ToString().ToUpper() : "U";

    <div class="sidebar-user">
        <div class="sidebar-user__avatar">@initials</div>
        <div class="sidebar-user__info">
            <span class="sidebar-user__name">@user?.Email</span>
            <span class="sidebar-user__role">Korisnik</span>
        </div>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-logout-btn" title="Odjava">
                <i class="fas fa-sign-out-alt"></i>
            </button>
        </form>
    </div>
}
else
{
    <div class="sidebar-user">
        <div class="sidebar-user__avatar"><i class="fas fa-user"></i></div>
        <div class="sidebar-user__info">
            <a asp-area="Identity" asp-page="/Account/Login" class="sidebar-auth-link">Prijava</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="sidebar-auth-link sidebar-auth-link--muted">Registracija</a>
        </div>
    </div>
}
