@model Sustavzapracenjenapretkauteretani.Web.Models.CiljCreateViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="form-section">
    <h2>Osnovni podaci</h2>
    <div class="form-grid">

        <partial name="_AutocompleteField" model='new AutocompleteFieldViewModel {
            FieldName = "KorisnikId",
            Label = "Korisnik",
            Endpoint = "/korisnici/pretraga",
            InitialValue = Model.KorisnikNaziv,
            InitialId = Model.KorisnikId > 0 ? Model.KorisnikId : null
        }' />

        <div class="form-field">
            <label asp-for="Tip"></label>
            <select asp-for="Tip" asp-items="Html.GetEnumSelectList<TipCilja>()"></select>
            <span asp-validation-for="Tip" class="validation-text"></span>
        </div>

        <div class="form-field">
            <label asp-for="CiljanaVrijednost"></label>
            <input asp-for="CiljanaVrijednost" type="number" min="0.1" max="10000" step="0.1" />
            <span asp-validation-for="CiljanaVrijednost" class="validation-text"></span>
            <span class="field-hint">Npr. 80 kg, 5 km, 100 kg snage...</span>
        </div>

        <partial name="_DatePickerPartial" model='new DatePickerViewModel {
            FieldName    = "Rok",
            Label        = "Rok za ostvarenje",
            InitialValue = Model.Rok != default(DateTime) ? Model.Rok.ToString("yyyy-MM-dd") : null,
            Hint         = "Do kojeg datuma želite postići cilj?"
        }' />

    </div>
</section>

<section class="form-section">
    <h2>Status</h2>
    <div class="form-grid">

        <div class="form-field form-field-full">
            <div style="display: flex; align-items: center; gap: 12px;">
                <input asp-for="Postignut" type="checkbox" id="Postignut" />
                <label for="Postignut" style="margin: 0; cursor: pointer;">Je li cilj već postignut?</label>
            </div>
            <span asp-validation-for="Postignut" class="validation-text"></span>
        </div>

    </div>
</section>
