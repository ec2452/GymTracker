@model List<Cilj>

@{
    ViewData["Title"] = "Ciljevi";
}

@* User.IsInRole() čita claims iz Identity cookie-a i radi bez ikakvog DI *@

<!-- HEADER -->
<div class="goal-header">
    <div>
        <h1>Ciljevi</h1>
        <p class="goal-count">
            @if (Model.Count == 0)
            {
                <span>Nema dostupnih ciljeva</span>
            }
            else
            {
                <span>Ukupno @Model.Count @(Model.Count == 1 ? "cilj" : "ciljeva")</span>
            }
        </p>
    </div>
    @* Gumb "Novi cilj" – samo Admin i Trainer *@
    @if (User.IsInRole("Admin") || User.IsInRole("Trainer"))
    {
        <a asp-route="CiljCreate" class="btn-action btn-action--primary">
            <i class="fas fa-plus"></i> Novi cilj
        </a>
    }
</div>

<!-- SEARCH -->
<div class="search-bar">
    <i class="fas fa-search search-bar__icon"></i>
    <input type="text" id="cilj-search-input" class="search-bar__input" placeholder="Pretraži ciljeve..." />
    <div id="cilj-search-results" class="search-bar__results"></div>
</div>

<!-- GOAL GRID -->
@if (Model.Count > 0)
{
    <div class="goal-grid">
        @foreach (var goal in Model)
        {
            var tipLabel = goal.Tip switch {
                TipCilja.Mrsavljenje    => "Mršavljenje",
                TipCilja.DobivanjeMase  => "Dobivanje mase",
                TipCilja.PovecanjeSnage => "Povećanje snage",
                TipCilja.Izdrzljivost   => "Izdržljivost",
                TipCilja.Fleksibilnost  => "Fleksibilnost",
                _                       => goal.Tip.ToString()
            };
            var tipClass = goal.Tip switch {
                TipCilja.Mrsavljenje    => "mrsavljenje",
                TipCilja.DobivanjeMase  => "dobivanjemase",
                TipCilja.PovecanjeSnage => "povecanjesnage",
                TipCilja.Izdrzljivost   => "izdrzljivost",
                TipCilja.Fleksibilnost  => "fleksibilnost",
                _                       => "mrsavljenje"
            };
            var tipIcon = goal.Tip switch {
                TipCilja.Mrsavljenje    => "fa-fire-alt",
                TipCilja.DobivanjeMase  => "fa-dumbbell",
                TipCilja.PovecanjeSnage => "fa-fist-raised",
                TipCilja.Izdrzljivost   => "fa-heartbeat",
                TipCilja.Fleksibilnost  => "fa-spa",
                _                       => "fa-bullseye"
            };

            var userName = goal.Korisnik is null
                ? $"Korisnik {goal.KorisnikId}"
                : $"{goal.Korisnik.Ime} {goal.Korisnik.Prezime}";

            var days = (goal.Rok - DateTime.Today).Days;
            string deadlineChipClass, deadlineText;
            if (goal.Postignut)
            {
                deadlineChipClass = "deadline-chip--done";
                deadlineText      = "Postignut";
            }
            else if (days < 0)
            {
                deadlineChipClass = "deadline-chip--overdue";
                deadlineText      = "Rok je prošao";
            }
            else if (days <= 7)
            {
                deadlineChipClass = "deadline-chip--warning";
                deadlineText      = days == 0 ? "Danas!" : $"Još {days} dana";
            }
            else
            {
                deadlineChipClass = "deadline-chip--ok";
                deadlineText      = goal.Rok.ToString("dd.MM.yyyy.");
            }

            <article class="goal-card goal-card--@tipClass">
                <!-- TOP ROW: tip badge + rok datum -->
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px;">
                    <span class="tip-badge tip-badge--@tipClass">
                        <i class="fas @tipIcon"></i> @tipLabel
                    </span>
                    <span class="deadline-chip @deadlineChipClass">
                        @if (goal.Postignut)
                        {
                            <i class="fas fa-check"></i>
                        }
                        else if (days < 0)
                        {
                            <i class="fas fa-exclamation-triangle"></i>
                        }
                        else if (days <= 7)
                        {
                            <i class="fas fa-clock"></i>
                        }
                        else
                        {
                            <i class="fas fa-calendar-alt"></i>
                        }
                        @deadlineText
                    </span>
                </div>

                <!-- USER -->
                <div class="goal-card-user">
                    <i class="fas fa-user"></i>
                    <span>@userName</span>
                </div>

                <!-- META: Ciljana vrijednost, Rok -->
                <div class="goal-meta">
                    <div class="goal-meta-item">
                        <div class="goal-meta-label">Ciljana vrijednost</div>
                        <div class="goal-meta-value">@goal.CiljanaVrijednost</div>
                    </div>
                    <div class="goal-meta-item">
                        <div class="goal-meta-label">Rok</div>
                        <div class="goal-meta-value">@goal.Rok.ToString("dd.MM.yyyy.")</div>
                    </div>
                </div>

                <!-- STATUS -->
                <div class="goal-status-badge @(goal.Postignut ? "completed" : "pending")">
                    @if (goal.Postignut)
                    {
                        <i class="fas fa-check-circle"></i>
                        <span>Postignut</span>
                    }
                    else
                    {
                        <i class="fas fa-hourglass-half"></i>
                        <span>U tijeku</span>
                    }
                </div>

                <!-- ACTIONS -->
                <div class="goal-footer">
                    @* Detalji – prikazuje se svima (server će preusmjeriti na login ako nije prijavljen) *@
                    <a asp-route="CiljDetails" asp-route-id="@goal.Id" asp-route-slug="@SlugHelper.Slugify(goal.Tip.ToString())" class="goal-button">
                        <i class="fas fa-arrow-right goal-button-icon"></i>
                        Detalji
                    </a>
                    @* Uredi – samo Admin i Trainer *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Trainer"))
                    {
                        <a asp-route="CiljEdit" asp-route-id="@goal.Id" asp-route-slug="@SlugHelper.Slugify(goal.Tip.ToString())" class="btn-action btn-action--edit" style="font-size: 13px; min-height: 36px; padding: 6px 12px;">
                            <i class="fas fa-edit"></i>
                        </a>
                    }
                    @* Obriši – SAMO Admin *@
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-route="CiljDelete" asp-route-id="@goal.Id" asp-route-slug="@SlugHelper.Slugify(goal.Tip.ToString())" class="btn-action btn-action--delete" style="font-size: 13px; min-height: 36px; padding: 6px 12px;">
                            <i class="fas fa-trash"></i>
                        </a>
                    }
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">🎯</div>
        <h2>Nema ciljeva</h2>
        <p>Počnite dodavanjem prvog cilja za praćenje napretka.</p>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        initIndexSearch('cilj-search-input', 'cilj-search-results', '/ciljevi/pretraga');
    });
</script>
