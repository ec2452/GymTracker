@page
@model Sustavzapracenjenapretkauteretani.Areas.Identity.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "Registracija — vanjski servis";
    Layout = null;
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registracija — GymTracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .auth-root {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            background: #0f172a;
        }

        .auth-page {
            width: 100%;
            max-width: 420px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
        }

        .auth-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            text-align: center;
        }

        .auth-brand__icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(145deg, #10b981, #059669);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        .auth-brand__icon i {
            font-size: 22px;
            color: #031a10;
        }

        .auth-brand__name {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 28px;
            font-weight: 700;
            color: #f8fafc;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .auth-brand__tagline {
            font-size: 13px;
            color: #94a3b8;
            margin-top: -4px;
        }

        .auth-card {
            width: 100%;
            background: #1f2937;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
        }

        .auth-card__heading {
            font-size: 20px;
            font-weight: 700;
            color: #f8fafc;
            margin-bottom: 4px;
            font-family: 'Inter', sans-serif;
        }

        .auth-card__sub {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 28px;
            font-family: 'Inter', sans-serif;
        }

        .auth-provider-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 6px;
            padding: 5px 10px;
            font-size: 12px;
            font-weight: 600;
            color: #10b981;
            font-family: 'Inter', sans-serif;
            margin-bottom: 24px;
        }

        .auth-error {
            background: rgba(220, 38, 38, 0.10);
            border: 1px solid rgba(220, 38, 38, 0.35);
            border-radius: 8px;
            padding: 10px 14px;
            color: #fca5a5;
            font-size: 13px;
            margin-bottom: 20px;
            font-family: 'Inter', sans-serif;
        }

        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .auth-field label {
            font-size: 13px;
            font-weight: 600;
            color: #cbd5e1;
            font-family: 'Inter', sans-serif;
        }

        .auth-field-wrap {
            position: relative;
        }

        .auth-field-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 13px;
            pointer-events: none;
        }

        .auth-field input[type="email"],
        .auth-field input[type="text"] {
            width: 100%;
            background: #1e293b;
            border: 1px solid #475569;
            color: #f8fafc;
            border-radius: 8px;
            padding: 10px 12px 10px 37px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            min-height: 44px;
            transition: border-color 0.15s, box-shadow 0.15s;
            outline: none;
            -webkit-appearance: none;
        }

        .auth-field input:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .auth-field input::placeholder {
            color: #64748b;
        }

        .auth-field-error {
            font-size: 12px;
            color: #fca5a5;
            font-family: 'Inter', sans-serif;
        }

        .btn-auth-primary {
            width: 100%;
            background: #10b981;
            color: #031a10;
            border: none;
            border-radius: 8px;
            padding: 12px 20px;
            font-size: 15px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
            margin-top: 8px;
        }

        .btn-auth-primary:hover {
            background: #34d399;
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        }

        .btn-auth-primary:active {
            transform: scale(0.98);
        }

        .auth-footer {
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            font-family: 'Inter', sans-serif;
        }

        .auth-footer a {
            color: #10b981;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover {
            color: #34d399;
        }

        @@media (max-width: 480px) {
            .auth-card { padding: 24px 20px; }
            .auth-root  { padding: 24px 16px; }
        }
    </style>
</head>
<body>
<div class="auth-root">
    <div class="auth-page">

        <div class="auth-brand">
            <div class="auth-brand__icon">
                <i class="fas fa-dumbbell"></i>
            </div>
            <span class="auth-brand__name">GymTracker</span>
            <span class="auth-brand__tagline">tvoj napredak, tvoja snaga</span>
        </div>

        <div class="auth-card">
            <h1 class="auth-card__heading">Dovršite registraciju</h1>
            <p class="auth-card__sub">Unesite osobne podatke za kreiranje računa</p>

            <div class="auth-provider-badge">
                <i class="fas fa-check-circle"></i>
                Prijavljeni putem @Model.ProviderDisplayName
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-error" role="alert">@Model.ErrorMessage</div>
            }

            <form id="confirmation-form" asp-page-handler="Confirmation"
                  asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email">Email adresa</label>
                    <div class="auth-field-wrap">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Input.Email" type="email"
                               autocomplete="email" placeholder="tvoj@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.OIB">OIB</label>
                    <div class="auth-field-wrap">
                        <i class="fas fa-id-card"></i>
                        <input asp-for="Input.OIB" type="text" placeholder="11 znamenki" />
                    </div>
                    <span asp-validation-for="Input.OIB" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.JMBG">JMBG</label>
                    <div class="auth-field-wrap">
                        <i class="fas fa-fingerprint"></i>
                        <input asp-for="Input.JMBG" type="text" placeholder="13 znamenki" />
                    </div>
                    <span asp-validation-for="Input.JMBG" class="auth-field-error"></span>
                </div>

                <button type="submit" class="btn-auth-primary">
                    <i class="fas fa-user-plus"></i>
                    Registriraj se
                </button>
            </form>
        </div>

        <div class="auth-footer">
            Već imaš račun?&nbsp;<a asp-page="./Login">Prijavi se</a>
        </div>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />
</body>
</html>
