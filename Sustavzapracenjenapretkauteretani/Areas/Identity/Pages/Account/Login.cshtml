@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
    Layout = null;
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prijava — GymTracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .auth-root {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            background: #0f172a;
        }

        .auth-page {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
        }

        /* ── Brand ── */
        .auth-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            text-align: center;
        }

        .auth-brand__icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(145deg, #10b981, #059669);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        .auth-brand__icon i {
            font-size: 22px;
            color: #031a10;
        }

        .auth-brand__name {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 28px;
            font-weight: 700;
            color: #f8fafc;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .auth-brand__tagline {
            font-size: 13px;
            color: #94a3b8;
            margin-top: -4px;
        }

        /* ── Card ── */
        .auth-card {
            width: 100%;
            background: #1f2937;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
        }

        .auth-card__heading {
            font-size: 20px;
            font-weight: 700;
            color: #f8fafc;
            margin-bottom: 4px;
            font-family: 'Inter', sans-serif;
        }

        .auth-card__sub {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 28px;
            font-family: 'Inter', sans-serif;
        }

        /* ── Validation error ── */
        .auth-error {
            background: rgba(220, 38, 38, 0.10);
            border: 1px solid rgba(220, 38, 38, 0.35);
            border-radius: 8px;
            padding: 10px 14px;
            color: #fca5a5;
            font-size: 13px;
            margin-bottom: 20px;
            font-family: 'Inter', sans-serif;
        }

        /* ── Form fields ── */
        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .auth-field label {
            font-size: 13px;
            font-weight: 600;
            color: #cbd5e1;
            font-family: 'Inter', sans-serif;
        }

        .auth-field-wrap {
            position: relative;
        }

        .auth-field-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 13px;
            pointer-events: none;
        }

        .auth-field input[type="email"],
        .auth-field input[type="password"],
        .auth-field input[type="text"] {
            width: 100%;
            background: #1e293b;
            border: 1px solid #475569;
            color: #f8fafc;
            border-radius: 8px;
            padding: 10px 12px 10px 37px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            min-height: 44px;
            transition: border-color 0.15s, box-shadow 0.15s;
            outline: none;
            -webkit-appearance: none;
        }

        .auth-field input:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .auth-field input::placeholder {
            color: #64748b;
        }

        .auth-field-error {
            font-size: 12px;
            color: #fca5a5;
            font-family: 'Inter', sans-serif;
        }

        /* ── Remember me ── */
        .auth-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
        }

        .auth-remember input[type="checkbox"] {
            width: 15px;
            height: 15px;
            accent-color: #10b981;
            cursor: pointer;
            flex-shrink: 0;
        }

        .auth-remember label {
            font-size: 13px;
            color: #94a3b8;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        /* ── Primary button ── */
        .btn-auth-primary {
            width: 100%;
            background: #10b981;
            color: #031a10;
            border: none;
            border-radius: 8px;
            padding: 12px 20px;
            font-size: 15px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }

        .btn-auth-primary:hover {
            background: #34d399;
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        }

        .btn-auth-primary:active {
            transform: scale(0.98);
        }

        /* ── Divider ── */
        .auth-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-family: 'Inter', sans-serif;
        }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #334155;
        }

        /* ── Google button ── */
        .btn-auth-google {
            width: 100%;
            background: transparent;
            border: 1px solid #475569;
            color: #f8fafc;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: border-color 0.15s, background 0.15s;
        }

        .btn-auth-google:hover {
            border-color: #94a3b8;
            background: rgba(255, 255, 255, 0.04);
        }

        .btn-auth-google svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        /* ── Footer link ── */
        .auth-footer {
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            font-family: 'Inter', sans-serif;
        }

        .auth-footer a {
            color: #10b981;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover {
            color: #34d399;
        }

        @@media (max-width: 480px) {
            .auth-card { padding: 24px 20px; }
            .auth-root  { padding: 24px 16px; }
        }
    </style>
</head>
<body>
<div class="auth-root">
    <div class="auth-page">

        <!-- Brand -->
        <div class="auth-brand">
            <div class="auth-brand__icon">
                <i class="fas fa-dumbbell"></i>
            </div>
            <span class="auth-brand__name">GymTracker</span>
            <span class="auth-brand__tagline">tvoj napredak, tvoja snaga</span>
        </div>

        <!-- Card -->
        <div class="auth-card">
            <h1 class="auth-card__heading">Dobrodošao natrag</h1>
            <p class="auth-card__sub">Unesi svoje podatke za prijavu</p>

            <!-- Email / Password form -->
            <form method="post">
                @Html.AntiForgeryToken()

                @{
                    var hasErrors = !ViewData.ModelState.IsValid &&
                                    ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);
                }
                @if (hasErrors)
                {
                    <div class="auth-error" role="alert">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <div class="auth-field">
                    <label asp-for="Input.Email">Email adresa</label>
                    <div class="auth-field-wrap">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Input.Email" type="email"
                               autocomplete="username" aria-required="true"
                               placeholder="tvoj@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password">Lozinka</label>
                    <div class="auth-field-wrap">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Input.Password" type="password"
                               autocomplete="current-password" aria-required="true"
                               placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="auth-field-error"></span>
                </div>

                <div class="auth-remember">
                    <input asp-for="Input.RememberMe" id="remember-me" />
                    <label for="remember-me">Zapamti me na ovom uređaju</label>
                </div>

                <button type="submit" class="btn-auth-primary">
                    <i class="fas fa-sign-in-alt"></i>
                    Prijavi se
                </button>
            </form>

            <!-- Google login (prikazuje se samo ako su kredencijali konfigurirani) -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-divider">ili</div>

                <form id="external-account" asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        if (provider.Name == "Google")
                        {
                            <button type="submit" class="btn-auth-google"
                                    name="provider" value="@provider.Name">
                                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                    <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.2l6.8-6.8C35.8 2.4 30.2 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.1C12.4 13 17.7 9.5 24 9.5z"/>
                                    <path fill="#4285F4" d="M46.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.2-10.1 7.2-17z"/>
                                    <path fill="#FBBC05" d="M10.5 28.6A14.6 14.6 0 0 1 9.5 24c0-1.6.3-3.1.7-4.6L2.3 13.3A23.9 23.9 0 0 0 0 24c0 3.8.9 7.4 2.6 10.6l7.9-6z"/>
                                    <path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7.5-5.8c-2 1.4-4.6 2.2-7.7 2.2-6.3 0-11.6-4.2-13.5-9.9l-7.9 6C6.5 42.5 14.6 48 24 48z"/>
                                </svg>
                                Nastavi s Googleom
                            </button>
                        }
                    }
                </form>
            }
        </div>

        <!-- Footer -->
        <div class="auth-footer">
            Nemaš račun?&nbsp;<a asp-page="./Register">Registriraj se besplatno</a>
        </div>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />
</body>
</html>
